# -------------------------------------------------------------
# Kolkata Job Map — Environment Configuration Template
# -------------------------------------------------------------

# Public Application URL (Used for sitemaps, robots.txt, and OpenGraph URLs)
NEXT_PUBLIC_SITE_URL=https://kolkata-job-map.vercel.app

# Optional: Transactional Mailer Configuration (Nodemailer)
# Required only if you want direct platform job applications to dispatch email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kolkata Job Map <no-reply@kolkatajobmap.in>"

# Optional: Testing email override
# If set, all submitted job applications will be forwarded to this address instead of the company contact
RECRUITER_OVERRIDE_EMAIL=
